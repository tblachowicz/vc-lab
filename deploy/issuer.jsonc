// Deployed by .github/workflows/deploy.yml with --var WALLET_URL and --var ISSUER_URL.
{
  "name": "vc-lab-issuer",
  "main": "issuer.worker.js",
  "compatibility_date": "2025-09-01",
  // Served only on the custom domain: workers.dev and preview URLs would show the account name.
  "workers_dev": false,
  "preview_urls": false,
  // A route, not a custom domain: custom domains each get their own certificate, and Safari then fails
  // with 421 when it reuses a connection across the lab's hostnames. Needs a proxied DNS record (AAAA 100::).
  "routes": [{ "pattern": "vc-lab-issuer.loft70.net/*", "zone_name": "loft70.net" }],
  "assets": { "directory": "../dist/issuer", "binding": "ASSETS" },
  "durable_objects": { "bindings": [{ "name": "STATE", "class_name": "IssuerState" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["IssuerState"] }],
  "observability": { "enabled": true }
}
