// VC Lab's home page: an assets-only Worker that introduces the lab and links to the three apps.
{
  "name": "vc-lab-home",
  "compatibility_date": "2025-09-01",
  "workers_dev": false,
  "preview_urls": false,
  // A route, not a custom domain: custom domains each get their own certificate, and Safari then fails
  // with 421 when it reuses a connection across the lab's hostnames. Needs a proxied DNS record (AAAA 100::).
  "routes": [{ "pattern": "vc-lab.loft70.net/*", "zone_name": "loft70.net" }],
  "assets": { "directory": "../dist/home", "html_handling": "auto-trailing-slash" }
}
