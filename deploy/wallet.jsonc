// The wallet is a static site: an assets-only Worker, no script. /offer serves offer.html.
{
  "name": "vc-lab-wallet",
  "compatibility_date": "2025-09-01",
  "workers_dev": false,
  "preview_urls": false,
  // A route, not a custom domain: custom domains each get their own certificate, and Safari then fails
  // with 421 when it reuses a connection across the lab's hostnames. Needs a proxied DNS record (AAAA 100::).
  "routes": [{ "pattern": "vc-lab-wallet.loft70.net/*", "zone_name": "loft70.net" }],
  "assets": { "directory": "../dist/wallet", "html_handling": "auto-trailing-slash" }
}
